PORT=5999
HOST=0.0.0.0
MCP_PUBLIC_URL=https://mcp.example.com
# Base64-encoded random secret, at least 32 bytes
JWT_SECRET=
MCP_DEFAULT_USER_EMAIL=demo@example.com
MCP_DEFAULT_USER_PASSWORD=
STORAGE_PATH=./data/app.sqlite
MCP_DEFAULT_USER_ID=demo-user

# Gmail API access: use a refresh token for long-running deployments.
# Required OAuth scope: https://www.googleapis.com/auth/gmail.readonly
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional short-lived access token for local smoke tests; takes precedence over refresh-token auth.
GMAIL_ACCESS_TOKEN=
