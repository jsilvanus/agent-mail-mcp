PORT=5999
HOST=0.0.0.0
MCP_PUBLIC_URL=https://mcp.example.com
# Base64-encoded random secret, at least 32 bytes
JWT_SECRET=
MCP_DEFAULT_USER_EMAIL=demo@example.com
MCP_DEFAULT_USER_PASSWORD=
STORAGE_PATH=./data/app.sqlite
MCP_DEFAULT_USER_ID=demo-user

# Gmail API access: use a refresh token for long-running deployments.
# Required OAuth scope: https://www.googleapis.com/auth/gmail.readonly
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional short-lived access token for local smoke tests; takes precedence over refresh-token auth.
GMAIL_ACCESS_TOKEN=

# HMAC key used to persist only a digest of each user's username+agent@gmail.com recipient.
# Generate at least 32 random bytes; changing it invalidates stored recipient digests.
AGENT_RECIPIENT_HMAC_SECRET=

# GDPR privacy notice: all fields below are required and non-empty at startup.
# These values are displayed publicly at /gdpr. Replace every placeholder with accurate,
# deployment-specific information before starting the service.
GDPR_CONTROLLER_NAME=
GDPR_CONTROLLER_ADDRESS=
GDPR_CONTROLLER_EMAIL=
GDPR_PRIVACY_CONTACT_EMAIL=
GDPR_PURPOSES=
GDPR_LAWFUL_BASIS=
GDPR_RETENTION=
GDPR_RECIPIENTS=
GDPR_INTERNATIONAL_TRANSFERS=
GDPR_SUPERVISORY_AUTHORITY=
# Optional: set only if a Data Protection Officer has been appointed.
GDPR_DPO_CONTACT=
